#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
    exec python3 guardrails/guardrail.py --mode staged
elif command -v python >/dev/null 2>&1; then
    exec python guardrails/guardrail.py --mode staged
else
    echo "❌ Python is required for Guardrail checks but was not found in PATH." >&2
    exit 1
fi
