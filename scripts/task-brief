#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE] [--validate]
set -euo pipefail

validate=false
plan=""
n=""
out=""

while [ $# -gt 0 ]; do
  case "$1" in
    --validate|-Validate|-v)
      validate=true
      shift
      ;;
    *)
      if [ -z "$plan" ]; then
        plan="$1"
      elif [ -z "$n" ]; then
        n="$1"
      elif [ -z "$out" ]; then
        out="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$plan" ] || [ -z "$n" ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE] [--validate]" >&2
  exit 2
fi

[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ -z "$out" ]; then
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

# PRE-FLIGHT TASK CONTRACT VALIDATION
if [ "$validate" = true ] || grep -Eiq "Goal|Objective|Acceptance|Criteria|Verify|Test" "$out"; then
  echo "🛡️ [PRE-FLIGHT GATE] Validating Task $n contract..."
  if ! grep -Eiq "Acceptance|Criteria|Verify|Test" "$out"; then
    echo "⚠️ Warning: Task $n is missing observable Acceptance Criteria!" >&2
  else
    echo "  ✅ Contract Valid: Goal and Acceptance criteria detected."
  fi
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines (Pre-flight Gate Verified ✅)"
